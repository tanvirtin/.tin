# tin .env template — gitignored, holds API keys and model defaults.
# Copy to ~/.tin/.env and fill in the keys you use. `tin env sync` pushes
# these into the agent (Pi) auth store and settings.
#
# Fully provider-agnostic: add a *_API_KEY for any supported provider.
# Recognized keys are synced to ~/.pi/agent/auth.json. See
# `tin env status` for what is currently configured.

# --- Anthropic ---
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Vercel AI Gateway ---
# AI_GATEWAY_API_KEY="vck_..."

# --- Defaults applied to the agent (Pi) settings on sync ---
# DEFAULT_PROVIDER="vercel-ai-gateway"
# DEFAULT_MODEL="deepseek/deepseek-v4-flash-0731"
